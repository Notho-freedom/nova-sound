rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - users can read/write their own profile
    match /users/{userId} {
      // Allow read/write if the user is authenticated and accessing their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow collection queries by email for account linking (findUserByEmail)
      allow read: if request.auth != null && resource != null && resource.data.email == request.auth.token.email;

      // Allow write for manual OAuth users (when creating profile with their UID)
      allow write: if request.auth != null && request.resource.data.uid == userId;
    }
    
    // AppData subcollection under users - for Firebase sync and backups
    match /users/{userId}/appData/{dataId} {
      // Allow read/write for the user's own data (Firebase Auth)
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow read/write for authenticated users if the email matches (for Google OAuth backup restore)
      // This allows manual OAuth users to access their data via email matching
      allow read, write: if request.auth != null 
        && request.auth.token.email != null 
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.email == request.auth.token.email;

      // Allow create for authenticated users writing their own data (backup creation)
      allow create: if request.auth != null && request.resource.data.uid == userId;
      
      // Allow create for authenticated users if email matches (for manual OAuth users)
      allow create: if request.auth != null 
        && request.auth.token.email != null 
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.email == request.auth.token.email;
    }
    
    // Playlists subcollection under users
    match /users/{userId}/playlists/{playlistId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Backups subcollection under users - for app data backups
    match /users/{userId}/backups/{backupId} {
      // Allow read/write for the user's own backups (Firebase Auth)
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow read/write for authenticated users if the email matches (for manual OAuth users)
      allow read, write: if request.auth != null 
        && request.auth.token.email != null 
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.email == request.auth.token.email;
    }
    
    // Sync data - users can only access their own sync data
    match /sync/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /sync/{userId}/tracks/{trackId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /sync/{userId}/playlists/{playlistId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Settings - users can only access their own settings
    match /settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User preferences
    match /preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

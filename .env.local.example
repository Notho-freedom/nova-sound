# ============================================
# Redis Configuration (L3 Cache - Optional)
# ============================================
# Redis is used as a distributed cache layer (L3) for YouTube data
# This is completely optional - the app works perfectly without it
# using localStorage (L2) and memory cache (L1)
#
# If you want to enable Redis caching:
# 1. Get a free Redis instance from: https://redis.com/try-free/ or https://upstash.com/
# 2. Copy these values to your .env.local file
# 3. Restart your dev server or redeploy

# Redis Host (e.g., redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com)
REDIS_HOST=your-redis-host.com

# Redis Port (usually 6379, or custom port from your provider)
REDIS_PORT=6379

# Redis Password (leave empty if no auth required)
REDIS_PASSWORD=your-redis-password

# Redis Database Number (0-15, usually 0)
REDIS_DB=0

# Optional: Redis connection timeout in milliseconds (default: 5000)
# REDIS_TIMEOUT=5000

# Optional: Enable TLS for secure connections (true for production)
# REDIS_TLS=true

# ============================================
# Note: Redis is OPTIONAL
# ============================================
# If these variables are not set, the app will:
# - Return 503 (Service Unavailable) from Redis API endpoints
# - Continue working perfectly with localStorage cache
# - Show "Redis: Non configuré" in Settings > Compte > À propos
# 
# This is the "offline-first" architecture - Redis is a nice-to-have
# enhancement, not a requirement.

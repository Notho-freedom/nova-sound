# Google OAuth Configuration
# Pour les applications Electron/Desktop, vous pouvez utiliser le type "Desktop app" ou "Web application"
# 
# Étapes:
# 1. Allez sur https://console.cloud.google.com
# 2. Créez un projet ou sélectionnez-en un
# 3. APIs & Services > Credentials > Create Credentials > OAuth client ID
# 4. Type: Desktop app OU Web application
# 5. Copiez le Client ID et Client Secret (si Web application)
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Client Secret (optionnel - uniquement pour Electron/Desktop apps)
# Ne PAS utiliser pour les applications web publiques
# Si vous avez un OAuth client de type "Web application", ajoutez le client_secret ici
VITE_GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret-here

# OAuth Proxy (Optionnel)
# Si vous avez un backend proxy pour gérer le client_secret de manière sécurisée
# Exemple: http://localhost:3000/api ou https://api.nexus-audio.com
# VITE_OAUTH_PROXY_URL=http://localhost:3000/api

# Stripe Configuration
# Obtenez votre clé publique depuis: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
VITE_STRIPE_PRICE_PRO_MONTHLY=price_your_monthly_price_id
VITE_STRIPE_PRICE_PRO_YEARLY=price_your_yearly_price_id

# API Backend URL (pour les endpoints Stripe et storage)
# Note: Le backend utilise le port 3001 par défaut si 3000 est occupé par Vite
# Exemple: http://localhost:3001 ou https://api.nexus-audio.com
VITE_API_URL=http://localhost:3001

# Backend Server Configuration (server/.env)
# PORT=3000
# FRONTEND_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# STRIPE_PRICE_PRO_MONTHLY=price_your_monthly_price_id
# STRIPE_PRICE_PRO_YEARLY=price_your_yearly_price_id
# STORAGE_DIR=./storage


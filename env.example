# ============================================
# NEXUS Audio Player - Variables d'environnement
# ============================================
# 
# Copiez ce fichier vers .env.local et remplissez les valeurs
# Ne commitez JAMAIS .env.local dans Git!
#
# ============================================

# ============================================
# Variables CLIENT (NEXT_PUBLIC_*)
# ============================================
# Ces variables sont exposées au navigateur.
# Ne JAMAIS mettre de secrets ici!

# Firebase Configuration (Client)
# Obtenez ces valeurs depuis: https://console.firebase.google.com
# Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Google OAuth Configuration (Client)
# Pour les applications Electron/Desktop, vous pouvez utiliser le type "Desktop app" ou "Web application"
# Étapes:
# 1. Allez sur https://console.cloud.google.com
# 2. Créez un projet ou sélectionnez-en un
# 3. APIs & Services > Credentials > Create Credentials > OAuth client ID
# 4. Type: Desktop app OU Web application
# 5. Copiez le Client ID
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# OAuth Proxy (Optionnel)
# Si vous avez un backend proxy pour gérer le client_secret de manière sécurisée
# Exemple: http://localhost:3000/api ou https://api.nexus-audio.com
# NEXT_PUBLIC_OAUTH_PROXY_URL=http://localhost:3000/api

# Stripe Configuration (Client)
# Obtenez votre clé publique depuis: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_your_monthly_price_id
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_your_yearly_price_id

# Frontend URL
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# API URL (Optionnel - par défaut utilise les routes Next.js)
# NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# Variables SERVEUR (sans préfixe NEXT_PUBLIC_)
# ============================================
# Ces variables sont UNIQUEMENT accessibles dans app/api/* (routes API).
# Ne JAMAIS les exposer au client!

# Google OAuth Configuration (Server)
# Même Client ID que côté client
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Stripe Configuration (Server)
# Obtenez votre clé secrète depuis: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PRICE_PRO_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_PRO_YEARLY=price_your_yearly_price_id

# Storage Configuration
# Répertoire de stockage local pour les fichiers (fallback si Bunny non configuré)
STORAGE_DIR=./storage

# Bunny CDN/Storage Configuration (Pro users only)
# Get your API key from: https://bunny.net
BUNNY_STORAGE_NAME=your-storage-zone-name
BUNNY_API_KEY=your-bunny-api-key
BUNNY_CDN_URL=https://your-cdn-url.b-cdn.net
# Optional: Token key for signed URLs (generate a secure random string)
# This enables secure, time-limited access to files
BUNNY_TOKEN_KEY=your-secret-token-key-for-url-signing

# PlanetHoster SFTP Configuration (Pro users only)
# ⚠️ SECURITY: SFTP is 100% encrypted (unlike FTP which sends passwords in plain text)
# NEVER use FTP in production - it's insecure!
# 
# SFTP uses SSH encryption - all data is encrypted end-to-end
# Recommended: Use SSH private key authentication (more secure than password)
#
# Get your SFTP credentials from your PlanetHoster control panel
PLANETHOSTER_SFTP_HOST=ftp.yourdomain.com
PLANETHOSTER_SFTP_PORT=22
PLANETHOSTER_SFTP_USER=your-ftp-username
PLANETHOSTER_SFTP_PASSWORD=your-ftp-password
# Optional: SSH Private Key (recommended - more secure than password)
# Generate with: ssh-keygen -t rsa -b 4096
# Then add the public key to your PlanetHoster account
# PLANETHOSTER_SFTP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# PLANETHOSTER_SFTP_PASSPHRASE=your-key-passphrase-if-encrypted
PLANETHOSTER_SFTP_BASE_PATH=/public_html
PLANETHOSTER_CDN_URL=https://yourdomain.com

# Firebase Admin SDK Configuration (for server-side authentication)
# Extract these values from your Firebase Admin SDK JSON file
# NEVER commit the JSON file to your repository!
# Use scripts/extract-firebase-env.js to extract the values
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Note: Keep the \n in FIREBASE_PRIVATE_KEY - they will be converted to actual newlines automatically

# ============================================
# Notes importantes
# ============================================
#
# 1. Variables NEXT_PUBLIC_* sont exposées au navigateur
#    → Ne jamais mettre de secrets ici!
#
# 2. Variables sans préfixe sont serveur uniquement
#    → Accessibles uniquement dans app/api/*
#
# 3. Pour la production:
#    → Utilisez des variables d'environnement de votre hébergeur
#    → Vercel: Project Settings > Environment Variables
#    → Netlify: Site Settings > Environment Variables
#
# 4. Validation:
#    → Exécutez: npm run validate:env
#    → Pour vérifier toutes les variables: npm run validate:env:all
#

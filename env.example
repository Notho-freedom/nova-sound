# Firebase Configuration
# Obtenez ces valeurs depuis la console Firebase: https://console.firebase.google.com
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Stripe Configuration
# Obtenez votre clé publique depuis: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
VITE_STRIPE_PRICE_PRO_MONTHLY=price_your_monthly_price_id
VITE_STRIPE_PRICE_PRO_YEARLY=price_your_yearly_price_id

# API Backend URL (pour les endpoints Stripe et storage)
# Exemple: http://localhost:3000 ou https://api.nexus-audio.com
VITE_API_URL=http://localhost:3000


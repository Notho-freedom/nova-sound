{
  "name": "nexus-audio",
  "private": true,
  "version": "1.0.1",
  "description": "NEXUS - Futuristic Audio Player",
  "author": "NEXUS Team",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently -k \"next dev\" \"npm run electron:dev\"",
    "electron:dev": "tsc -p electron/tsconfig.json && powershell -Command \"if (-not (Test-Path 'dist-electron/services')) { New-Item -ItemType Directory -Path 'dist-electron/services' -Force }; Copy-Item -Path 'electron/preload.cjs' -Destination 'dist-electron/preload.cjs' -Force\" && electron .",
    "build": "next build",
    "compile:electron": "tsc -p electron/tsconfig.json && powershell -Command \"if (-not (Test-Path 'dist-electron')) { New-Item -ItemType Directory -Path 'dist-electron' -Force }; Copy-Item -Path 'electron/preload.cjs' -Destination 'dist-electron/preload.cjs' -Force\"",
    "build:electron": "npm run build && npm run compile:electron",
    "start": "next start",
    "build:dev": "vite build --mode development",
    "electron": "npm run build:electron && powershell -Command \"$env:FORCE_PROD='true'; electron .\"",
    "bump-version": "npx tsx scripts/bump-version.ts",
    "package": "npm run bump-version && npm run compile:electron && electron-builder",
    "package:win": "npm run bump-version && npm run compile:electron && electron-builder --win",
    "package:mac": "npm run bump-version && npm run compile:electron && electron-builder --mac",
    "package:linux": "npm run bump-version && npm run compile:electron && electron-builder --linux",
    "build:prod": "npx tsx scripts/build-production.ts",
    "lint": "eslint .",
    "preview": "next start",
    "test": "vitest run",
    "test:contract": "vitest run src/contract/**/*.test.ts",
    "test:api": "node scripts/test-api-routes.mjs",
    "test:planethoster": "npx tsx scripts/test-planethoster.ts",
    "test:metadata": "npx tsx scripts/test-artist-metadata.ts",
    "validate:env": "node scripts/validate-env.js",
    "validate:env:all": "node scripts/validate-env.js --check-all",
    "create:stripe-products": "npx tsx scripts/create-stripe-test-products.ts",
    "worker:tasks": "npx tsx scripts/upstash-worker.ts",
    "clean": "powershell -Command \"if (Test-Path '.next') { Remove-Item -Path '.next' -Recurse -Force }; if (Test-Path 'dist-electron') { Remove-Item -Path 'dist-electron' -Recurse -Force }; if (Test-Path 'dist') { Remove-Item -Path 'dist' -Recurse -Force }\""
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.7",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/electron": "^7.6.0",
    "@sentry/nextjs": "^10.34.0",
    "@sentry/node": "^10.34.0",
    "@stripe/stripe-js": "^8.5.3",
    "@tanstack/react-query": "^5.83.0",
    "@types/multer": "^2.0.0",
    "@types/react-helmet": "^6.1.11",
    "@upstash/qstash": "^2.8.4",
    "@upstash/redis": "^1.36.1",
    "@upstash/vector": "^1.2.2",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "electron-updater": "^6.3.9",
    "basic-ftp": "^5.0.5",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "form-data": "^4.0.5",
    "framer-motion": "^12.23.26",
    "google-auth-library": "^10.5.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "meilisearch": "^0.55.0",
    "multer": "^2.0.2",
    "music-metadata": "^10.6.4",
    "next": "^16.0.8",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.61.1",
    "react-joyride": "^2.9.3",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "react-virtualized-auto-sizer": "^2.0.2",
    "react-window": "^1.8.7",
    "recharts": "^2.15.4",
    "redis": "^5.10.0",
    "sonner": "^1.7.4",
    "ssh2-sftp-client": "^12.0.1",
    "stripe": "^20.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unzipper": "^0.10.14",
    "uuid": "^11.0.3",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "dotenv": "^17.2.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "ignore-loader": "^0.1.2",
    "jsdom": "^27.3.0",
    "lovable-tagger": "^1.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^4.0.15",
    "yaml": "^2.8.1"
  },
  "build": {
    "appId": "com.nexus.audio",
    "productName": "Nexus Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "wav",
          "flac",
          "aac",
          "ogg",
          "m4a",
          "opus",
          "wma",
          "aiff",
          "mp2",
          "mp1",
          "ac3",
          "dts",
          "ape",
          "tta",
          "tak",
          "ofr",
          "ofs",
          "off",
          "rka",
          "shn",
          "aa",
          "aax",
          "act",
          "aiff",
          "alac",
          "au",
          "awb",
          "dct",
          "dss",
          "dvf",
          "gsm",
          "iklax",
          "ivs",
          "m4b",
          "mmf",
          "msv",
          "nmf",
          "nsf",
          "oga",
          "mogg",
          "ra",
          "rm",
          "raw",
          "rf64",
          "sln",
          "tta",
          "voc",
          "vox",
          "wv",
          "webm"
        ],
        "name": "Audio File",
        "role": "Viewer",
        "description": "NEXUS Audio File"
      },
      {
        "ext": [
          "mp4",
          "avi",
          "mkv",
          "webm",
          "mov",
          "wmv",
          "flv",
          "m4v",
          "3gp",
          "3g2",
          "asf",
          "rm",
          "rmvb",
          "vob",
          "ogv",
          "divx",
          "xvid",
          "m2v",
          "mts",
          "m2ts",
          "ts",
          "f4v",
          "amv",
          "drc",
          "gifv",
          "mxf",
          "roq",
          "nsv",
          "yuv",
          "viv",
          "svi",
          "mng",
          "qt",
          "yuv",
          "rm",
          "asf",
          "amv",
          "rmvb",
          "flv",
          "f4v",
          "swf",
          "wmv",
          "vob",
          "ogv",
          "drc",
          "gifv",
          "mng",
          "m2v",
          "svi",
          "3g2",
          "3gp",
          "nsv",
          "roq",
          "nsv",
          "flv",
          "f4v",
          "swf",
          "wmv",
          "vob",
          "ogv",
          "drc",
          "gifv",
          "mng",
          "m2v",
          "svi",
          "3g2",
          "3gp",
          "nsv",
          "roq"
        ],
        "name": "Video File",
        "role": "Viewer",
        "description": "NEXUS Video File"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico",
      "publish": [
        {
          "provider": "generic",
          "url": "${env.ELECTRON_UPDATER_URL}",
          "channel": "latest"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/favicon.ico",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/favicon.ico",
      "category": "Audio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
